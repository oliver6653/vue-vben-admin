# 环境变量配置
# 生产环境建议通过部署平台传入环境变量，减少包体积

# 应用标题
VITE_APP_TITLE=Vben Admin Element Plus

# 开发者工具开关（默认开启）
VITE_DEVTOOLS=true

# 是否注入APP加载元素
VITE_INJECT_APP_LOADING=true

# 是否启用mock
VITE_NITRO_MOCK=true

# 是否启用PWA
VITE_PWA=false

# 是否启用打包预览
VITE_VISUALIZER=false

# 是否启用打包压缩
# 可选: gzip, brotli, none
VITE_COMPRESS=gzip

# 是否启用打包归档
VITE_ARCHIVER=false